generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Board {
  id     Int    @id @default(autoincrement())
  title  String
  lists  List[]
}

model List {
  id      Int    @id @default(autoincrement())
  title   String
  boardId Int
  Board   Board  @relation(fields: [boardId], references: [id])
  tasks   Task[]
}

model Task {
  id       Int    @id @default(autoincrement())
  title    String
  listId   Int
  position Int     @default(0)
  List     List    @relation(fields: [listId], references: [id])
}

